# Application
APP_NAME=Docs RAG API
APP_ENV=development
DEBUG=true

# Database (matches docker-compose service "db" exposed on host port 5434)
DATABASE_URL=postgresql+psycopg://docs_rag:docs_rag@localhost:5434/docs_rag

# JWT (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS (comma-separated origins, or * for dev)
CORS_ORIGINS=*

# Google Gemini - same key works for both chat completion and embeddings.
# Get one for free at https://aistudio.google.com/apikey (no credit card).
GEMINI_API_KEY=replace-with-your-key
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# RAG knobs - sane defaults for portfolio-sized documents
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=80
RETRIEVAL_TOP_K=5
